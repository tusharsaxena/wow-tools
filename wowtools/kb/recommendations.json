{
 "comment": "The Config Editor's recommendations (spec CE7): one CVar value each, for the flavors whose CVar list has the CVar (warcraft.wiki.gg's Console variables pages, Patch 12.1.5, 1.60.1, 5.5.4, 2.5.6 and 1.15.9). The reason is in our own words; the source is where the CVar's meaning comes from. An unsourced recommendation is not shipped.",
 "recommendations": [
  {
   "cvar": "nameplateShowAll",
   "value": "1",
   "flavors": [
    "_retail_",
    "_forever_",
    "_classic_",
    "_anniversary_",
    "_classic_era_"
   ],
   "reason": "Shows nameplates out of combat too, so you can see what is around you before a pull.",
   "source": "https://warcraft.wiki.gg/wiki/Console_variables/Classic"
  },
  {
   "cvar": "nameplateShowEnemyMinions",
   "value": "1",
   "flavors": [
    "_retail_",
    "_forever_",
    "_classic_",
    "_anniversary_",
    "_classic_era_"
   ],
   "reason": "Shows nameplates for enemy pets, guardians and totems, which you often need to see and kill.",
   "source": "https://warcraft.wiki.gg/wiki/Console_variables/Classic"
  },
  {
   "cvar": "nameplateOccludedAlphaMult",
   "value": "0.4",
   "flavors": [
    "_classic_",
    "_anniversary_",
    "_classic_era_"
   ],
   "reason": "Fades the nameplates of units behind walls or terrain, so the ones you can actually reach stand out. 0.4 is the value Retail ships with.",
   "source": "https://warcraft.wiki.gg/wiki/Console_variables/Classic"
  },
  {
   "cvar": "nameplateSelectedScale",
   "value": "1.2",
   "flavors": [
    "_classic_",
    "_anniversary_",
    "_classic_era_"
   ],
   "reason": "Draws your target's nameplate a little larger than the rest, so it is easy to find in a pack. 1.2 is the value Retail ships with.",
   "source": "https://warcraft.wiki.gg/wiki/Console_variables/Classic"
  },
  {
   "cvar": "cameraDistanceMaxZoomFactor",
   "value": "2.6",
   "flavors": [
    "_retail_"
   ],
   "reason": "Lets the camera zoom out to the farthest distance the client allows (2.6 times the base, about 39 yards) for a wider view in raids and battlegrounds.",
   "source": "https://warcraft.wiki.gg/wiki/CVar_cameraDistanceMaxZoomFactor"
  },
  {
   "cvar": "cameraDistanceMaxZoomFactor",
   "value": "4",
   "flavors": [
    "_classic_",
    "_anniversary_",
    "_classic_era_"
   ],
   "reason": "Lets the camera zoom out to the farthest distance the Classic client allows (4 times the base, capped at 50 yards) for a wider view.",
   "source": "https://warcraft.wiki.gg/wiki/CVar_cameraDistanceMaxZoomFactor"
  },
  {
